{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000", "http://localhost:3001" ]
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": { "Path": "/api/v1/auth/{**catch-all}" }
      },
      "user-route": {
        "ClusterId": "user-cluster",
        "Match": { "Path": "/api/v1/users/{**catch-all}" }
      },
      "content-route": {
        "ClusterId": "content-cluster",
        "Match": { "Path": "/api/v1/content/{**catch-all}" }
      },
      "media-route": {
        "ClusterId": "media-cluster",
        "Match": { "Path": "/api/v1/media/{**catch-all}" }
      },
      "community-route": {
        "ClusterId": "community-cluster",
        "Match": { "Path": "/api/v1/community/{**catch-all}" }
      },
      "corporate-route": {
        "ClusterId": "corporate-cluster",
        "Match": { "Path": "/api/v1/corporate/{**catch-all}" }
      },
      "gamification-route": {
        "ClusterId": "gamification-cluster",
        "Match": { "Path": "/api/v1/gamification/{**catch-all}" }
      },
      "analytics-route": {
        "ClusterId": "analytics-cluster",
        "Match": { "Path": "/api/v1/analytics/{**catch-all}" }
      },
      "search-route": {
        "ClusterId": "search-cluster",
        "Match": { "Path": "/api/v1/search/{**catch-all}" }
      },
      "ai-route": {
        "ClusterId": "ai-cluster",
        "Match": { "Path": "/api/v1/ai/{**catch-all}" }
      },
      "booking-route": {
        "ClusterId": "booking-cluster",
        "Match": { "Path": "/api/v1/bookings/{**catch-all}" }
      },
      "coach-route": {
        "ClusterId": "coach-cluster",
        "Match": { "Path": "/api/v1/coaches/{**catch-all}" }
      },
      "journal-route": {
        "ClusterId": "journal-cluster",
        "Match": { "Path": "/api/v1/journals/{**catch-all}" }
      },
      "mood-route": {
        "ClusterId": "mood-cluster",
        "Match": { "Path": "/api/v1/moods/{**catch-all}" }
      },
      "notification-route": {
        "ClusterId": "notification-cluster",
        "Match": { "Path": "/api/v1/notifications/{**catch-all}" }
      },
      "payment-route": {
        "ClusterId": "payment-cluster",
        "Match": { "Path": "/api/v1/payments/{**catch-all}" }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": { "auth": { "Address": "http://localhost:5197/" } }
      },
      "user-cluster": {
        "Destinations": { "user": { "Address": "http://localhost:5208/" } }
      },
      "content-cluster": {
        "Destinations": { "content": { "Address": "http://localhost:5053/" } }
      },
      "media-cluster": {
        "Destinations": { "media": { "Address": "http://localhost:5098/" } }
      },
      "community-cluster": {
        "Destinations": { "community": { "Address": "http://localhost:5149/" } }
      },
      "corporate-cluster": {
        "Destinations": { "corporate": { "Address": "http://localhost:5289/" } }
      },
      "gamification-cluster": {
        "Destinations": { "gamification": { "Address": "http://localhost:5041/" } }
      },
      "analytics-cluster": {
        "Destinations": { "analytics": { "Address": "http://localhost:5110/" } }
      },
      "search-cluster": {
        "Destinations": { "search": { "Address": "http://localhost:5192/" } }
      },
      "ai-cluster": {
        "Destinations": { "ai": { "Address": "http://localhost:5193/" } }
      },
      "booking-cluster": {
        "Destinations": { "booking": { "Address": "http://localhost:5003/" } }
      },
      "coach-cluster": {
        "Destinations": { "coach": { "Address": "http://localhost:5136/" } }
      },
      "journal-cluster": {
        "Destinations": { "journal": { "Address": "http://localhost:5170/" } }
      },
      "mood-cluster": {
        "Destinations": { "mood": { "Address": "http://localhost:5160/" } }
      },
      "notification-cluster": {
        "Destinations": { "notification": { "Address": "http://localhost:5239/" } }
      },
      "payment-cluster": {
        "Destinations": { "payment": { "Address": "http://localhost:5254/" } }
      }
    }
  }
}
