{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000", "http://localhost:3001" ]
  },
  "ReverseProxy": {
    "Routes": {

      "auth-route":         { "ClusterId": "auth-cluster",         "Match": { "Path": "/api/v1/auth/{**catch-all}" } },
      "user-route":         { "ClusterId": "user-cluster",         "Match": { "Path": "/api/v1/users/{**catch-all}" } },
      "gamification-route": { "ClusterId": "gamification-cluster", "Match": { "Path": "/api/v1/gamification/{**catch-all}" } },
      "ai-route":           { "ClusterId": "ai-cluster",           "Match": { "Path": "/api/v1/ai/{**catch-all}" } },
      "mood-route":         { "ClusterId": "mood-cluster",         "Match": { "Path": "/api/v1/moods/{**catch-all}" } },
      "journal-route":      { "ClusterId": "journal-cluster",      "Match": { "Path": "/api/v1/journals/{**catch-all}" } },
      "community-route":    { "ClusterId": "community-cluster",    "Match": { "Path": "/api/v1/community/{**catch-all}" } },
      "coach-route":        { "ClusterId": "coach-cluster",        "Match": { "Path": "/api/v1/coaches/{**catch-all}" } },
      "booking-route":      { "ClusterId": "booking-cluster",      "Match": { "Path": "/api/v1/bookings/{**catch-all}" } },
      "payment-route":      { "ClusterId": "payment-cluster",      "Match": { "Path": "/api/v1/payments/{**catch-all}" } },
      "webhook-route":      { "ClusterId": "payment-cluster",      "Match": { "Path": "/api/v1/webhooks/{**catch-all}" } },
      "notification-route": { "ClusterId": "notification-cluster", "Match": { "Path": "/api/v1/notifications/{**catch-all}" } },
      "content-route":      { "ClusterId": "content-cluster",      "Match": { "Path": "/api/v1/content/{**catch-all}" } },
      "media-route":        { "ClusterId": "media-cluster",        "Match": { "Path": "/api/v1/media/{**catch-all}" } },
      "corporate-route":    { "ClusterId": "corporate-cluster",    "Match": { "Path": "/api/v1/corporate/{**catch-all}" } },
      "analytics-route":    { "ClusterId": "analytics-cluster",    "Match": { "Path": "/api/v1/analytics/{**catch-all}" } },
      "search-route":       { "ClusterId": "search-cluster",       "Match": { "Path": "/api/v1/search/{**catch-all}" } },

      "swagger-auth":         { "ClusterId": "auth-cluster",         "Match": { "Path": "/swagger-json/auth/{**catch-all}" },         "Transforms": [ { "PathRemovePrefix": "/swagger-json/auth" } ] },
      "swagger-user":         { "ClusterId": "user-cluster",         "Match": { "Path": "/swagger-json/user/{**catch-all}" },         "Transforms": [ { "PathRemovePrefix": "/swagger-json/user" } ] },
      "swagger-ai":           { "ClusterId": "ai-cluster",           "Match": { "Path": "/swagger-json/ai/{**catch-all}" },           "Transforms": [ { "PathRemovePrefix": "/swagger-json/ai" } ] },
      "swagger-mood":         { "ClusterId": "mood-cluster",         "Match": { "Path": "/swagger-json/mood/{**catch-all}" },         "Transforms": [ { "PathRemovePrefix": "/swagger-json/mood" } ] },
      "swagger-journal":      { "ClusterId": "journal-cluster",      "Match": { "Path": "/swagger-json/journal/{**catch-all}" },      "Transforms": [ { "PathRemovePrefix": "/swagger-json/journal" } ] },
      "swagger-coach":        { "ClusterId": "coach-cluster",        "Match": { "Path": "/swagger-json/coach/{**catch-all}" },        "Transforms": [ { "PathRemovePrefix": "/swagger-json/coach" } ] },
      "swagger-booking":      { "ClusterId": "booking-cluster",      "Match": { "Path": "/swagger-json/booking/{**catch-all}" },      "Transforms": [ { "PathRemovePrefix": "/swagger-json/booking" } ] },
      "swagger-payment":      { "ClusterId": "payment-cluster",      "Match": { "Path": "/swagger-json/payment/{**catch-all}" },      "Transforms": [ { "PathRemovePrefix": "/swagger-json/payment" } ] },
      "swagger-notification": { "ClusterId": "notification-cluster", "Match": { "Path": "/swagger-json/notification/{**catch-all}" }, "Transforms": [ { "PathRemovePrefix": "/swagger-json/notification" } ] },
      "swagger-community":    { "ClusterId": "community-cluster",    "Match": { "Path": "/swagger-json/community/{**catch-all}" },    "Transforms": [ { "PathRemovePrefix": "/swagger-json/community" } ] },
      "swagger-content":      { "ClusterId": "content-cluster",      "Match": { "Path": "/swagger-json/content/{**catch-all}" },      "Transforms": [ { "PathRemovePrefix": "/swagger-json/content" } ] },
      "swagger-media":        { "ClusterId": "media-cluster",        "Match": { "Path": "/swagger-json/media/{**catch-all}" },        "Transforms": [ { "PathRemovePrefix": "/swagger-json/media" } ] },
      "swagger-corporate":    { "ClusterId": "corporate-cluster",    "Match": { "Path": "/swagger-json/corporate/{**catch-all}" },    "Transforms": [ { "PathRemovePrefix": "/swagger-json/corporate" } ] },
      "swagger-gamification": { "ClusterId": "gamification-cluster", "Match": { "Path": "/swagger-json/gamification/{**catch-all}" }, "Transforms": [ { "PathRemovePrefix": "/swagger-json/gamification" } ] },
      "swagger-analytics":    { "ClusterId": "analytics-cluster",    "Match": { "Path": "/swagger-json/analytics/{**catch-all}" },    "Transforms": [ { "PathRemovePrefix": "/swagger-json/analytics" } ] },
      "swagger-search":       { "ClusterId": "search-cluster",       "Match": { "Path": "/swagger-json/search/{**catch-all}" },       "Transforms": [ { "PathRemovePrefix": "/swagger-json/search" } ] }
    },

    "Clusters": {
      "auth-cluster":         { "Destinations": { "auth":         { "Address": "http://localhost:5197/" } } },
      "user-cluster":         { "Destinations": { "user":         { "Address": "http://localhost:5208/" } } },
      "ai-cluster":           { "Destinations": { "ai":           { "Address": "http://localhost:5193/" } } },
      "mood-cluster":         { "Destinations": { "mood":         { "Address": "http://localhost:5160/" } } },
      "journal-cluster":      { "Destinations": { "journal":      { "Address": "http://localhost:5170/" } } },
      "coach-cluster":        { "Destinations": { "coach":        { "Address": "http://localhost:5136/" } } },
      "booking-cluster":      { "Destinations": { "booking":      { "Address": "http://localhost:5003/" } } },
      "payment-cluster":      { "Destinations": { "payment":      { "Address": "http://localhost:5254/" } } },
      "notification-cluster": { "Destinations": { "notification": { "Address": "http://localhost:5239/" } } },
      "community-cluster":    { "Destinations": { "community":    { "Address": "http://localhost:5149/" } } },
      "content-cluster":      { "Destinations": { "content":      { "Address": "http://localhost:5053/" } } },
      "media-cluster":        { "Destinations": { "media":        { "Address": "http://localhost:5098/" } } },
      "corporate-cluster":    { "Destinations": { "corporate":    { "Address": "http://localhost:5289/" } } },
      "gamification-cluster": { "Destinations": { "gamification": { "Address": "http://localhost:5041/" } } },
      "analytics-cluster":    { "Destinations": { "analytics":    { "Address": "http://localhost:5110/" } } },
      "search-cluster":       { "Destinations": { "search":       { "Address": "http://localhost:5192/" } } }
    }
  }
}
